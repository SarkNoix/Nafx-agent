# 模型文件太大，不进仓库
models/*.gguf

# 运行时产生的东西
agent/logs/
agent/state.json
agent/queue.json
agent/session.jsonl
agent/stream.jsonl
agent/panel.pid
agent/ask.json
agent/answer.json
logs/
workspace/*.tmp

# 系统
Thumbs.db
desktop.ini

# 运行时数据（不该进仓库）
agent/autopilot.json
agent/autopilot-history.jsonl
agent/memory/

# 调参产物：每次训练都会生成一大批备份和报告
train/out/
train/sandbox-config.json

# 用户工作区里的临时文件和自动备份
workspace/.backup/
workspace/test/

# 开发期整包备份
/_backup_*/

# 个人配置文件与调参备份
config.json.bak
config.self.json.bak

# GPU 运行时（CUDA 版 llama.cpp，按机器自己放，约 50 MB+）
/llama-gpu/

# 工作区数据目录：只留仓库自带的两个示例，其余测试产物一律不提交
workspace/data/*
!workspace/data/orders.jsonl
!workspace/data/smoke-test.txt

# API 密钥：本地文件，绝不能进仓库
api-key.json

cache/

