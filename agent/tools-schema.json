      "description": "查微软官方文档。命令的用法、参数记不清时用它，比凭记忆答准。",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "要查的命令名，如 Get-ChildItem"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "web_search",
      "description": "上网搜索。**凡是问你不知道的事实（今年/最新/谁得了奖/多少钱/什么版本），必须先搜，不许凭记忆猜。** 搜完拿到结果再说；搜不到就如实说搜不到，别编。",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "要搜索的关键词，别写整句话"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "web_fetch",
      "description": "打开一个网址读正文。web_search 给了链接、要看详情时用它。path 填完整 http(s) 链接。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "完整网址，如 https://example.com"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "rethink",
      "description": "走偏了重来。把当前几步的推理清空，重新想 —— 用在发现自己方向错了、或者连续几次同一个工具都失败的时候。",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "为什么要重来，一句话。写清楚哪里错了，重想的时候能看到"
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "think",
      "description": "先想清楚再动手。**新任务的第一个动作必须是这个。**把推理写进 content：要什么结果、分几步、这步为什么这么做。**这是给自己看的，用户看不到** —— 要跟用户说话用 note。控制在 150 字以内，别写长篇分析。",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "你的推理，100 字以内，写在这里"
          }
        },
        "required": [
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan",
      "description": "列计划：把要做的事拆成几步，每步写清用什么工具、产出什么。复杂任务的第一步就该调它，之后每完成一步在 think 里对照着走。",
      "parameters": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "string",
            "description": "任务清单，一步一行"
          }
        },
        "required": [
          "steps"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "say",
      "description": "问用户。只在真的缺信息、猜不出来的时候用 —— 会卡住等你回答。进度播报用 note，别用这个。",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "要问用户的话。说清楚缺什么、为什么要问，一句话讲完"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "learn",
      "description": "记教训。path=任务关键词 find=踩的坑 replace=正确做法",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文件路径（相对工作区，如 data/x.txt）"
          },
          "find": {
            "type": "string",
            "description": "要找的原文"
          },
          "replace": {
            "type": "string",
            "description": "替换成什么"
          }
        },
        "required": [
          "find"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "unzip",
      "description": "解压压缩包（zip / tar / gz / 7z / rar）。先看压缩包里有什么用 zip_list，别直接解。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "压缩包路径（相对工作区，如 data.zip）"
          },
          "command": {
            "type": "string",
            "description": "解压到哪个目录，留空就解到同名文件夹"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ps",
      "description": "看进程。command 写 memory 或留空=按内存排序",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "命令或参数文本"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "install",
      "description": "用winget装软件。command 写 search 关键词 只搜索",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "命令或参数文本"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "finish",
      "description": "收尾并给答案。**是工具不是文字**，要在 tool_calls 里调，别直接输出 \"finish(...)\" 这行字。",
      "parameters": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "description": "给用户的最终答案，一句话说清结果"
          }
        },
        "required": [
          "answer"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "note",
      "description": "对用户说一句话，说完立刻继续（不等待回答）。多步任务里每做完一步用它交代进度：「note.txt 挪好了，还剩 2 个 log，接着挪」。**不是问问题** —— 要问用 say。",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "要对用户说的话，一句，说清做了什么、接下来干什么"
          }
        },
        "required": [
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "http_request",
      "description": "发 HTTP 请求（GET/POST/PUT/DELETE/PATCH），可带 header 和 body，返回状态码和正文。抓网页正文用 web_fetch，搜索用 web_search，别拿这个当搜索用。",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "完整地址，如 https://api.example.com/v1/items"
          },
          "method": {
            "type": "string",
            "description": "GET（默认）/ POST / PUT / DELETE / PATCH"
          },
          "headers": {
            "type": "string",
            "description": "可选。JSON 对象字符串，如 {\"Authorization\":\"Bearer xxx\"}"
          },
          "body": {
            "type": "string",
            "description": "可选。请求正文；POST JSON 时直接传 JSON 字符串"
          },
          "contentType": {
            "type": "string",
            "description": "可选。默认 application/json（有 body 时）"
          },
          "timeout": {
            "type": "number",
            "description": "可选。超时秒数，默认 20，最大 60"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "pdf_read",
      "description": "读 PDF 里的文字，按页取。默认读前 8 页、最多 1500 字符；要后面的页用 pages 指定（如 \"3\"、\"1-5\"、\"all\"）。扫描件/加密件读不出文字会明确说。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "PDF 文件路径（相对工作区）"
          },
          "pages": {
            "type": "string",
            "description": "可选。如 \"3\" 读第3页、\"1-5\" 读1到5页、\"all\" 读全部（仍受 maxChars 限制）"
          },
          "maxChars": {
            "type": "number",
            "description": "可选。最多返回多少字符，默认 1500，上限 4000"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "notify",
      "description": "弹系统提醒（Windows 托盘气泡）。长任务快做完时提醒用户回来看，别每一步都弹。",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "提醒内容，一句话说清什么好了"
          },
          "title": {
            "type": "string",
            "description": "可选。标题，默认 Nafx"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  },
  {
    "function": {
      "name": "net_http",
      "parameters": {
        "required": [
          "url"
        ],
        "properties": {
          "save": {
            "description": "可选：把响应体存文件",
            "type": "string"
          },
          "timeout": {
            "description": "超时秒数，默认 15，最多 60",
            "type": "integer"
          },
          "body": {
            "description": "请求体文本；有 body 且没给 contentType 时默认 application/json",
            "type": "string"
          },
          "url": {
            "description": "完整地址，如 http://127.0.0.1:8090/api/health",
            "type": "string"
          },
          "insecure": {
            "description": "true = 接受自签证书（只用于本机 https 调试）",
            "type": "boolean"
          },
          "headers": {
            "description": "请求头，如 X-Token: abc; Accept: application/json",
            "type": "string"
          },
          "maxBody": {
            "description": "正文最多多少字，默认 4000",
            "type": "integer"
          },
          "contentType": {
            "description": "Content-Type，可省略",
            "type": "string"
          },
          "method": {
            "description": "GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS，默认 GET",
            "type": "string"
          },
          "proxy": {
            "type": "string",
            "description": "可选：走调试代理 http://127.0.0.1:8899"
          }
        },
        "type": "object"
      },
      "description": "发 HTTP 请求，看状态码、响应头和正文前 4000 字。例：net_http(url=\"http://127.0.0.1:8090/api\")。"
    },
    "type": "function"
  },
  {
    "function": {
      "name": "net_capture",
      "parameters": {
        "properties": {
          "url": {
            "type": "string",
            "description": "抓自己的请求给这个 URL，如 http://127.0.0.1:9100/api/secure"
          },
          "method": {
            "type": "string",
            "description": "配合 url，默认 GET"
          },
          "headers": {
            "type": "string",
            "description": "配合 url，如 X-Token: abc"
          },
          "port": {
            "type": "integer",
            "description": "只抓这个端口"
          },
          "seconds": {
            "type": "integer",
            "description": "抓几秒，默认 5"
          },
          "pktSize": {
            "type": "integer",
            "description": "每包字节，默认 512"
          },
          "ip": {
            "type": "string",
            "description": "只抓这个 IP"
          },
          "proto": {
            "type": "string",
            "description": "tcp/udp/icmp"
          },
          "file": {
            "type": "string",
            "description": "输出文件名"
          }
        },
        "type": "object",
        "required": [
          "url"
        ]
      },
      "description": "抓包（pktmon，需管理员）。抓自己的请求给 url，会替你发一次并按该 URL 的端口过滤；只抓端口给 port。例：net_capture(url=\"http://127.0.0.1:9100/api/secure\")。"
    },
    "type": "function"
  },
  {
    "function": {
      "name": "net_proxy",
      "parameters": {
        "required": [
          "action"
        ],
        "properties": {
          "rules": {
            "description": "规则 JSON（对象或字符串）：{\"rules\":[{\"name\":\"mock健康检查\",\"url\":\"/api/health\",\"action\":\"mock\",\"status\":200,\"body\":\"{\\\"ok\\\":true}\"},{\"name\":\"加调试头\",\"url\":\"/api/\",\"setHeaders\":{\"X-Debug\":\"1\"}},{\"name\":\"拦删除\",\"method\":\"DELETE\",\"urlRegex\":\"/api/\",\"action\":\"block\"}]}",
            "type": "string"
          },
          "clear": {
            "description": "log 时顺便清空日志",
            "type": "boolean"
          },
          "action": {
            "description": "start=启动 / stop=停止 / status=状态 / rules=设规则 / log=看最近请求 / clear=清日志",
            "type": "string"
          },
          "port": {
            "description": "监听端口，默认 8899",
            "type": "integer"
          },
          "limit": {
            "description": "log：看最近几条，默认 10",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "description": "本机 HTTP 调试代理（只监听 127.0.0.1）：记录/改写请求、mock 响应、拦截 403。HTTPS 只隧道不解密。action=start/stop/status/rules/log/clear。rules 传 JSON，如 {\"rules\":[{\"name\":\"m\",\"url\":\"/api\",\"action\":\"mock\",\"status\":200,\"body\":\"ok\"}]}。"
    },
    "type": "function"
  },
  {
    "function": {
      "name": "net_send",
      "parameters": {
        "required": [
          "port",
          "data"
        ],
        "properties": {
          "port": {
            "description": "目标端口（必填，1-65535）",
            "type": "integer"
          },
          "hex": {
            "description": "true = data 按十六进制解析，如 48 65 6C 6C 6F",
            "type": "boolean"
          },
          "host": {
            "description": "目标主机，默认 127.0.0.1",
            "type": "string"
          },
          "proto": {
            "description": "tcp 或 udp，默认 tcp",
            "type": "string"
          },
          "waitMs": {
            "description": "发完等回复多少毫秒，默认 1500，最多 10000",
            "type": "integer"
          },
          "count": {
            "description": "重复发几次，默认 1，最多 20",
            "type": "integer"
          },
          "data": {
            "description": "要发的内容（文本）；hex=true 时写十六进制",
            "type": "string"
          },
          "intervalMs": {
            "description": "每次之间间隔毫秒",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "description": "发 TCP/UDP 裸包（文本或 hex），等一会儿读回复。返回收发字节数、耗时、回复片段。例：net_send(port=9000, data=\"PING\\n\")。"
    },
    "type": "function"
  },
  {
    "function": {
      "name": "net_ports",
      "parameters": {
        "properties": {
          "port": {
            "description": "只看这个端口",
            "type": "integer"
          },
          "limit": {
            "description": "最多几条，默认 20",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "description": "查本机端口和进程：服务起没起、端口被谁占。例：net_ports(port=9100)。"
    },
    "type": "function"
  },
  {
    "type": "function",
    "function": {
      "name": "net_packets",
      "description": "看抓包文件里的包。file 省略用最新；index=N 看该包的完整请求和响应。",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "pcapng 文件名或路径，默认最新"
