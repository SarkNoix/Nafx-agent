      "description": "上网搜索。**凡是问你不知道的事实（今年/最新/谁得了奖/多少钱/什么版本），必须先搜，不许凭记忆猜。** 搜完拿到结果再说；搜不到就如实说搜不到，别编。",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "要搜索的关键词，别写整句话"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "web_fetch",
      "description": "打开一个网址读正文。web_search 给了链接、要看详情时用它。path 填完整 http(s) 链接。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "完整网址，如 https://example.com"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "rethink",
      "description": "走偏了重来。清空当前步骤，重新想",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "think",
      "description": "先想清楚再动手。**新任务的第一个动作必须是这个。**把推理写进 content：要什么结果、分几步、这步为什么这么做。**这是给自己看的，用户看不到** —— 要跟用户说话用 note。控制在 150 字以内，别写长篇分析。",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "你的推理，100 字以内，写在这里"
          }
        },
        "required": [
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan",
      "description": "列计划：把要做的事拆成几步，每步写清用什么工具、产出什么。复杂任务的第一步就该调它，之后每完成一步在 think 里对照着走。",
      "parameters": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "string",
            "description": "任务清单，一步一行"
          }
        },
        "required": [
          "steps"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "say",
      "description": "问用户",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "要对用户说的话"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "learn",
      "description": "记教训。path=任务关键词 find=踩的坑 replace=正确做法",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文件路径（相对工作区，如 data/x.txt）"
          },
          "find": {
            "type": "string",
            "description": "要找的原文"
          },
          "replace": {
            "type": "string",
            "description": "替换成什么"
          }
        },
        "required": [
          "find"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "unzip",
      "description": "解压 zip/tar/gz/7z/rar",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "文件路径（相对工作区，如 data/x.txt）"
          },
          "command": {
            "type": "string",
            "description": "解到哪个目录，留空用同名"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ps",
      "description": "看进程。command 写 memory 或留空=按内存排序",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "命令或参数文本"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "install",
      "description": "用winget装软件。command 写 search 关键词 只搜索",
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "命令或参数文本"
          }
        },
        "required": [
          "command"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "finish",
      "description": "收尾并给答案。**是工具不是文字**，要在 tool_calls 里调，别直接输出 \"finish(...)\" 这行字。",
      "parameters": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string",
            "description": "给用户的最终答案，一句话说清结果"
          }
        },
        "required": [
          "answer"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "note",
      "description": "对用户说一句话，说完立刻继续（不等待回答）。多步任务里每做完一步用它交代进度：「note.txt 挪好了，还剩 2 个 log，接着挪」。**不是问问题** —— 要问用 say。",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "要对用户说的话，一句，说清做了什么、接下来干什么"
          }
        },
        "required": [
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "http_request",
      "description": "发 HTTP 请求（GET/POST/PUT/DELETE/PATCH），可带 header 和 body，返回状态码和正文。抓网页正文用 web_fetch，搜索用 web_search，别拿这个当搜索用。",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "完整地址，如 https://api.example.com/v1/items"
          },
          "method": {
            "type": "string",
            "description": "GET（默认）/ POST / PUT / DELETE / PATCH"
          },
          "headers": {
            "type": "string",
            "description": "可选。JSON 对象字符串，如 {\"Authorization\":\"Bearer xxx\"}"
          },
          "body": {
            "type": "string",
            "description": "可选。请求正文；POST JSON 时直接传 JSON 字符串"
          },
          "contentType": {
            "type": "string",
            "description": "可选。默认 application/json（有 body 时）"
          },
          "timeout": {
            "type": "number",
            "description": "可选。超时秒数，默认 20，最大 60"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "pdf_read",
      "description": "读 PDF 里的文字，按页取。默认读前 8 页、最多 1500 字符；要后面的页用 pages 指定（如 \"3\"、\"1-5\"、\"all\"）。扫描件/加密件读不出文字会明确说。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "PDF 文件路径（相对工作区）"
          },
          "pages": {
            "type": "string",
            "description": "可选。如 \"3\" 读第3页、\"1-5\" 读1到5页、\"all\" 读全部（仍受 maxChars 限制）"
          },
          "maxChars": {
            "type": "number",
            "description": "可选。最多返回多少字符，默认 1500，上限 4000"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "notify",
      "description": "弹系统提醒（Windows 托盘气泡）。长任务快做完时提醒用户回来看，别每一步都弹。",
      "parameters": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "提醒内容，一句话说清什么好了"
          },
          "title": {
            "type": "string",
            "description": "可选。标题，默认 Nafx"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  }
]