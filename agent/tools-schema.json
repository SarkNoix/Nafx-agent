          "index": {
            "type": "integer",
            "description": "看第 N 个包（从 1 开始）"
          },
          "port": {
            "type": "integer",
            "description": "只看这个端口"
          },
          "proto": {
            "type": "string",
            "description": "tcp / udp / http"
          },
          "contains": {
            "type": "string",
            "description": "载荷包含这段文字"
          },
          "limit": {
            "type": "integer",
            "description": "列表最多几条，默认 20"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "net_rewrite",
      "description": "把包里某个 HTTP 请求改完按 TCP 重发，返回状态码和响应片段。例：net_rewrite(index=1, setHeaders=\"X-Token: abc\")。",
      "parameters": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "pcapng 文件名，默认最新"
          },
          "index": {
            "type": "integer",
            "description": "第几个包（从 1 开始）"
          },
          "method": {
            "type": "string",
            "description": "改成 GET/POST 等"
          },
          "replaceUrl": {
            "type": "string",
            "description": "改路径/URL"
          },
          "setHeaders": {
            "type": "string",
            "description": "改请求头，如 X-Token: abc; Accept: application/json"
          },
          "removeHeaders": {
            "type": "string",
            "description": "删请求头，分号分隔"
          },
          "body": {
            "type": "string",
            "description": "替换 body"
          },
          "bodyReplace": {
            "type": "string",
            "description": "替换 body 片段 旧=>新，多组用 ;;"
          },
          "host": {
            "type": "string",
            "description": "改发到的主机"
          },
          "port": {
            "type": "integer",
            "description": "改发到的端口"
          },
          "waitMs": {
            "type": "integer",
            "description": "等回复毫秒，默认 2000"
          },
          "save": {
            "type": "string",
            "description": "把改写后的请求存文件"
          }
        },
        "required": [
          "index"
        ]
      }
    }
  }
]