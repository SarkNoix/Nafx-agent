{
  "_说明": "流程模板。核心原则：能用一条命令直接算出结果的，就直接跑，别绕。命令搞不定再查技能库。",
  "version": 3,
  "_优先级": "① 一条命令能解决的 → 直接 run_cmd。② 命令不方便的 → skill 查现成脚本。③ 都没有 → 自己写。多绕一步就多几十秒。",
  "flows": [
    {
      "id": "count",
      "tools": [
        "think",
        "run_cmd",
        "read_file",
        "write_file",
        "append_file",
        "list_dir",
        "skill",
        "finish"
      ],
      "name": "数数量 / 统计",
      "match": [
        "多少",
        "几个",
        "几条",
        "几行",
        "数量",
        "统计",
        "总数",
        "一共",
        "加起来",
        "求和",
        "合计",
        "总额",
        "总金额",
        "总和",
        "平均",
        "均值",
        "最大",
        "最小"
      ],
      "goal": "拿到工具算出的真实数字，并说清这个数字是什么",
      "suggest_tools": [
        "skill sum_field",
        "skill json_query",
        "run_cmd",
        "skill count_ext",
        "list_dir",
        "skill text_stats"
      ],
      "reject_tools": [
        "find_duplicates",
        "batch_rename",
        "archive_by_date",
        "unzip_all",
        "write_file"
      ],
      "steps": [
        {
          "n": 1,
          "do": "先想：能不能一条命令直接算出来？能就直接 run_cmd，别绕",
          "need": "命令真跑过，返回里有数字"
        },
        {
          "n": 2,
          "do": "一条命令搞不定，才 skill(command=\"list\") 找现成脚本",
          "need": "确认技能库里有没有"
        },
        {
          "n": 3,
          "do": "把工具返回的数字原样写进 finish 的 answer",
          "need": "answer 里的数字和工具输出一致"
        }
      ],
      "cheatsheet": [
        "数某个目录有几个文件：run_cmd(dir /b \"data\" | find /c /v \"\")",
        "数文件有几行：run_cmd(find /c /v \"\" data\\x.txt)",
        "按扩展名分类统计：skill(count_ext -Path data)",
        "整个目录所有文本多少行：skill(text_stats -Path data)",
        "jsonl 有多少条：run_cmd(find /c /v \"\" data\\x.jsonl)",
        "某字段求和：skill(sum_field -Path data\\x.jsonl -Field amount)",
        "或者直接查字段（自动给求和/平均/最值）：skill(json_query -Path data\\x.jsonl -Pattern amount)",
        "算日期（几天后是几号、还有几天）：date_calc(21) 或 date_calc(2026-12-25) —— 别用 run_cmd 硬算"
      ],
      "forbid": [
        "没跑工具就直接报数字",
        "数字凭印象或凭经验写",
        "一条命令能搞定却先去查技能库（多绕一步就多几十秒）"
      ],
      "example": "任务：data 目录里有几个文件\n→ run_cmd(dir /b data | find /c /v \"\") 返回 2\n→ finish(answer=\"data 里有 2 个文件\")\n\n任务：订单金额加起来多少\n→ skill(sum_field -Path data/orders.jsonl -Field amount) 返回合计 7486\n→ finish(answer=\"订单金额合计 7486\")"
    },
    {
      "id": "lookup",
      "tools": [
