        },
        {
          "n": 3,
          "do": "finish 说清找到的是什么，找不到也要说明找过哪里",
          "need": "答案基于实际内容"
        }
      ],
      "cheatsheet": [
        "读文件：read_file(path=\"data/x.txt\")",
        "看目录：list_dir(path=\"data\")",
        "表格查某人某项：skill(csv_query -Path staff.csv -Find 张三 -Field 金额)",
        "哪个文件里有某词：skill(search_text -Pattern 关键词 -Path .)",
        "文件里某行：run_cmd(findstr /n \"关键词\" data\\x.txt)",
        "目录结构：skill(tree -Path data)",
        "表格整体统计：skill(csv_stats -Path staff.csv)",
        "网页正文：skill(web_fetch_text -Url https://example.com -Out page.txt)"
      ],
      "forbid": [
        "没读就编内容",
        "找不到还说找到了",
        "把整个文件原样贴进 answer"
      ],
      "example": "任务：张三的金额是多少\n→ skill(csv_query -Path staff.csv -Find 张三 -Field 金额)\n→ finish(answer=\"张三的金额是 1500 和 700\")"
    },
