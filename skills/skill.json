{
    "version":  4,
    "note":  "每个技能是一个验证过能跑的 .ps1。模型只需要判断该用哪个，不需要自己写代码。写着「默认预览」的技能要加 -Apply 才真动手，这是保护数据。",
    "skills":  [
                   {
                       "name":  "find_duplicates",
                       "title":  "找重复文件",
                       "desc":  "找出目录里内容重复的文件（按哈希判断，不看文件名）",
                       "triggers":  [
                                        "重复文件",
                                        "重复的",
                                        "一样的文件",
                                        "内容相同",
                                        "去重",
                                        "重复内容"
                                    ],
                       "params":  "-Path \u003c目录，默认当前目录\u003e",
                       "example":  "skill(command=\"find_duplicates -Path test\")"
                   },
                   {
                       "name":  "count_ext",
                       "title":  "按扩展名统计",
                       "desc":  "统计目录里每种扩展名各有多少个文件",
                       "triggers":  [
                                        "扩展名",
                                        "按类型统计",
                                        "各种格式",
                                        "文件类型",
                                        "有几类",
                                        "每种类型",
                                        "类型各有多少",
                                        "几种文件",
                                        "各有多少个"
                                    ],
                       "params":  "-Path \u003c目录，默认当前目录\u003e",
                       "example":  "skill(command=\"count_ext -Path test\")"
                   },
                   {
                       "name":  "sum_field",
                       "title":  "字段求和",
                       "desc":  "对 jsonl / csv / xlsx 里某个数值字段求和、求平均、求最大最小",
                       "triggers":  [
                                        "求和",
                                        "总和",
                                        "合计",
                                        "加起来",
                                        "一共多少钱",
                                        "平均值",
                                        "最大",
                                        "最小",
                                        "总计"
                                    ],
                       "params":  "-Path \u003c文件\u003e -Field \u003c字段名，默认 amount\u003e",
                       "example":  "skill(command=\"sum_field -Path data/orders.jsonl -Field amount\")"
                   },
                   {
                       "name":  "find_large",
                       "title":  "找大文件",
                       "desc":  "列出目录里最大的 N 个文件",
                       "triggers":  [
                                        "大文件",
                                        "占空间",
                                        "最大的文件",
                                        "占用最多",
                                        "空间不够",
                                        "哪个文件大",
                                        "最大的是哪"
                                    ],
                       "params":  "-Path \u003c目录，默认当前目录\u003e -Top \u003c几个，默认10\u003e",
                       "example":  "skill(command=\"find_large -Path . -Top 5\")"
                   },
                   {
                       "name":  "batch_rename",
                       "title":  "批量改名",
                       "desc":  "给目录里文件加前缀/后缀，或替换名字里的一段。默认只预览，加 -Apply 才真改",
                       "triggers":  [
                                        "批量改名",
                                        "重命名",
                                        "加前缀",
                                        "改文件名",
                                        "统一改名"
                                    ],
                       "params":  "-Path \u003c目录\u003e -AddPrefix \u003c前缀\u003e 或 -AddSuffix \u003c后缀\u003e 或 -Replace \u003c旧\u003e=\u003c新\u003e [-Apply]",
                       "example":  "skill(command=\"batch_rename -Path test -AddPrefix bak_\")"
                   },
                   {
                       "name":  "text_stats",
                       "title":  "文本统计",
                       "desc":  "统计文件的行数、字数、字符数；目录则统计所有文本合计",
                       "triggers":  [
                                        "多少行",
                                        "行数",
                                        "字数",
                                        "字符数",
                                        "统计文本",
                                        "几行"
                                    ],
                       "params":  "-Path \u003c文件或目录\u003e",
                       "example":  "skill(command=\"text_stats -Path data/orders.jsonl\")"
                   },
                   {
                       "name":  "compare_files",
                       "title":  "比较两个文件",
                       "desc":  "判断两个文件内容是否完全相同（先比大小再比哈希）",
                       "triggers":  [
                                        "比较文件",
                                        "两个文件一样吗",
                                        "对比文件",
                                        "是否相同",
                                        "有区别吗"
                                    ],
                       "params":  "-Path \u003c文件A\u003e -With \u003c文件B\u003e",
                       "example":  "skill(command=\"compare_files -Path a.txt -With b.txt\")"
                   },
                   {
                       "name":  "search_text",
