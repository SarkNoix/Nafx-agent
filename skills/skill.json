                       "params":  "-Path \u003c目录\u003e -Ext \u003c.txt\u003e -Out \u003c输出文件\u003e [-WithName]",
                       "example":  "skill(command=\"merge_files -Path logs -Ext .log -Out all.log -WithName\")"
                   },
                   {
                       "name":  "dedupe_lines",
                       "title":  "重复行去重",
                       "desc":  "去掉文件里重复的行。默认输出到 _deduped 新文件，加 -Apply 才覆盖原文件",
                       "triggers":  [
                                        "去重",
                                        "重复行",
                                        "删掉重复",
                                        "只留一份"
                                    ],
                       "params":  "-Path \u003c文件\u003e [-Apply]",
                       "example":  "skill(command=\"dedupe_lines -Path list.txt\")"
                   },
                   {
                       "name":  "csv_to_jsonl",
