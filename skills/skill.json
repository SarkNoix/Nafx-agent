                       "params":  "-Pattern \u003c要找什么\u003e -Path \u003c文件或目录\u003e [-Ext .txt,.log] [-IgnoreCase]",
                       "example":  "skill(command=\"search_text -Pattern 错误 -Path . -Ext .log\")"
                   },
                   {
                       "name":  "replace_text",
                       "title":  "批量替换文字",
                       "desc":  "把文件里的某段文字换成另一段。默认只预览，加 -Apply 才真改",
                       "triggers":  [
                                        "替换",
                                        "换成",
                                        "改成",
                                        "批量修改文字",
                                        "全部改"
                                    ],
                       "params":  "-Path \u003c文件或目录\u003e -Find \u003c旧\u003e -Replace \u003c新\u003e [-Ext .txt] [-Apply]",
                       "example":  "skill(command=\"replace_text -Path test -Find old -Replace new -Apply\")"
                   },
                   {
                       "name":  "tree",
                       "title":  "目录树",
                       "desc":  "把目录结构打印成树形，带文件大小和数量",
                       "triggers":  [
                                        "目录结构",
                                        "树形",
                                        "整个目录",
                                        "都有什么",
                                        "结构图",
                                        "展开目录"
                                    ],
                       "params":  "-Path \u003c目录\u003e [-Depth \u003c层数，默认3\u003e]",
                       "example":  "skill(command=\"tree -Path . -Depth 3\")"
